root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
charset = utf-8
configure_await_analysis_mode = library

[*.cs]
indent_size = 4

[*.csproj]
indent_size = 2
# EF Core names the migration classes after the names given to `dotnet ef migrations add`.
[OpenWorker.Persistence/Migrations/*.cs]
dotnet_diagnostic.CS8981.severity = none
