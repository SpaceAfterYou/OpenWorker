<Project Sdk="Microsoft.NET.Sdk">

    <!--
      What the district and the maze both run: the person of a player read from its row, and the handlers whose rules are
      the same on both servers. A handler here is concrete, so every process that loads this assembly registers it; only the
      district and the maze reference it. Where the two servers differ, in who hears what a player does, the server gives
      its IPlayerAudience (AddServerCommon).
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenWorker.Channel\OpenWorker.Channel.csproj" />
        <ProjectReference Include="..\OpenWorker.Commands\OpenWorker.Commands.csproj" />
        <ProjectReference Include="..\OpenWorker.Gameplay\OpenWorker.Gameplay.csproj" />
        <ProjectReference Include="..\OpenWorker.Persistence\OpenWorker.Persistence.csproj" />
        <ProjectReference Include="..\OpenWorker.Res\OpenWorker.Res.csproj" />
        <ProjectReference Include="..\OpenWorker.Runtime\OpenWorker.Runtime.csproj" />
    </ItemGroup>

</Project>
