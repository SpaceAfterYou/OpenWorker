<Project Sdk="Microsoft.NET.Sdk">

    <!-- A scratch measurement of what a maze costs when a player enters it (docs/phase-5/README.md, step 5). Not part of
         the solution. Run it from this folder with dotnet run -c Release, the folder of the maze scripts as the argument. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <AnalysisLevel>none</AnalysisLevel>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../../OpenWorker.Lua/OpenWorker.Lua.csproj" />
    </ItemGroup>

</Project>
