<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <!-- Kestrel and the health check middleware serve /healthz and /readyz. A server that references this project
             needs the ASP.NET Core runtime, which is why its image is dotnet/aspnet and not dotnet/runtime. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Arch" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <!-- The tests drive the accept and read loops of the server over a socket. -->
        <InternalsVisibleTo Include="OpenWorker.Hotspot.Test" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenWorker.Channel\OpenWorker.Channel.csproj" />
        <ProjectReference Include="..\OpenWorker.Domain\OpenWorker.Domain.csproj"/>
        <ProjectReference Include="..\OpenWorker.Extensions\OpenWorker.Extensions.csproj"/>
        <ProjectReference Include="..\OpenWorker.Runtime\OpenWorker.Runtime.csproj" />
        <ProjectReference Include="..\OpenWorker.Infrastructure.Redis\OpenWorker.Infrastructure.Redis.csproj" />
        <ProjectReference Include="..\OpenWorker.Persistence\OpenWorker.Persistence.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OpenWorker.AuthServer.Test" />
    </ItemGroup>

</Project>
