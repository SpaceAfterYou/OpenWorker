<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <!-- Kestrel and the health check middleware serve /healthz and /readyz. A server that references this project
             needs the ASP.NET Core runtime, which is why its image is dotnet/aspnet and not dotnet/runtime. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Arch" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenWorker.Channel\OpenWorker.Channel.csproj" />
        <ProjectReference Include="..\OpenWorker.Domain\OpenWorker.Domain.csproj"/>
        <ProjectReference Include="..\OpenWorker.Extensions\OpenWorker.Extensions.csproj"/>
        <ProjectReference Include="..\OpenWorker.Hotspot\OpenWorker.Hotspot.csproj"/>
        <ProjectReference Include="..\OpenWorker.Persistence\OpenWorker.Persistence.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OpenWorker.AuthServer.Test" />
    </ItemGroup>

</Project>
