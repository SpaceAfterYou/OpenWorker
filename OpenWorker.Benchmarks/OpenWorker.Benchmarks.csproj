<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Measurements of the hot path with BenchmarkDotNet. CI builds it and never runs it.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenWorker.Runtime\OpenWorker.Runtime.csproj" />
        <ProjectReference Include="..\OpenWorker.Lua\OpenWorker.Lua.csproj" />
        <ProjectReference Include="..\OpenWorker.DistrictServer\OpenWorker.DistrictServer.csproj" />
    </ItemGroup>

</Project>
