<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
        <!--
          Displays error on console in addition to the log file. Note that this feature comes with a performance impact.
          For more information, visit https://learn.microsoft.com/dotnet/core/testing/unit-testing-platform-integration-dotnet-test#show-failure-per-test
          -->
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Arch" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
        <PackageReference Include="MSTest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Datas\1.4.2.3\"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\OpenWorker.Gameplay\OpenWorker.Gameplay.csproj" />
      <ProjectReference Include="..\OpenWorker.Runtime\OpenWorker.Runtime.csproj" />
      <ProjectReference Include="..\OpenWorker.Infrastructure.Redis\OpenWorker.Infrastructure.Redis.csproj" />
      <ProjectReference Include="..\OpenWorker.Lua\OpenWorker.Lua.csproj" />
      <ProjectReference Include="..\OpenWorker.Navigation\OpenWorker.Navigation.csproj" />
      <ProjectReference Include="..\OpenWorker.Channel\OpenWorker.Channel.csproj" />
      <ProjectReference Include="..\OpenWorker.AuthServer\OpenWorker.AuthServer.csproj" />
      <ProjectReference Include="..\OpenWorker.GateServer\OpenWorker.GateServer.csproj" />
      <ProjectReference Include="..\OpenWorker.DistrictServer\OpenWorker.DistrictServer.csproj" />
      <ProjectReference Include="..\OpenWorker.MazeServer\OpenWorker.MazeServer.csproj" />
      <ProjectReference Include="..\OpenWorker.RelayServer\OpenWorker.RelayServer.csproj" />
      <ProjectReference Include="..\OpenWorker.SourceGenerator.ResourceStructures\OpenWorker.SourceGenerator.ResourceStructures.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The settings each server ships: ServerStartTest builds every server with them. -->
        <Content Include="..\OpenWorker.AuthServer\appsettings.json" Link="ServerSettings\AuthServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.GateServer\appsettings.json" Link="ServerSettings\GateServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.DistrictServer\appsettings.json" Link="ServerSettings\DistrictServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.MazeServer\appsettings.json" Link="ServerSettings\MazeServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.RelayServer\appsettings.json" Link="ServerSettings\RelayServer.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
