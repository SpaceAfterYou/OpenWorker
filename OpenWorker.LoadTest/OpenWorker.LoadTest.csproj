<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- The bot allocates little in the steady state, so the background collector would only add a thread. -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenWorker.Hotspot\OpenWorker.Hotspot.csproj" />
        <ProjectReference Include="..\OpenWorker.Persistence\OpenWorker.Persistence.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OpenWorker.LoadTest.Test" />
    </ItemGroup>

</Project>
