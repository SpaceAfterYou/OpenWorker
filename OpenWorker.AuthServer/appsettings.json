{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "Server": {
    "Port": 10000
  },
  "Game": {
    "Version": "1.4.2.3"
  },
  "Hotspot": {
    "PacketDumpPath": "test/hotspot",
    "ErrorBudget": {
      "MaxErrors": 10,
      "Window": "00:01:00"
    }
  },
  "Health": {
    "Port": 8080,
    "LoopTimeout": "00:00:05",
    "CheckTimeout": "00:00:03"
  },
  "Shutdown": {
    "Timeout": "00:00:30",
    "DrainTimeout": "00:00:15"
  },
  "Telemetry": {
    "Endpoint": "http://prometheus:9090/api/v1/otlp/v1/metrics",
    "Protocol": "HttpProtobuf",
    "ExportInterval": "00:00:10"
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=openworker;Username=postgres",
    "Redis": "redis://redis:6379"
  },
  "Auth": {
    "AllowNextHumanNetworkLogin": false
  }
}
