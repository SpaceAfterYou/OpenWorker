<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- The defaults of the server: the image needs them next to the assembly. -->
        <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenWorker.Batch\OpenWorker.Batch.csproj"/>
        <ProjectReference Include="..\OpenWorker.Domain\OpenWorker.Domain.csproj"/>
        <ProjectReference Include="..\OpenWorker.Hotspot\OpenWorker.Hotspot.csproj"/>
        <ProjectReference Include="..\OpenWorker.Persistence\OpenWorker.Persistence.csproj"/>
        <ProjectReference Include="..\OpenWorker.Res\OpenWorker.Res.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CodeDom" />
    </ItemGroup>

</Project>
