<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MSTest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\OpenWorker.AuthServer.Gameplay\OpenWorker.AuthServer.Gameplay.csproj" />
      <ProjectReference Include="..\OpenWorker.DependencyInjection\OpenWorker.DependencyInjection.csproj" />
      <ProjectReference Include="..\OpenWorker.GateServer.Gameplay\OpenWorker.GateServer.Gameplay.csproj" />
      <ProjectReference Include="..\OpenWorker.Hotspot\OpenWorker.Hotspot.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The defaults each server ships: TestServerOptions checks them. -->
        <Content Include="..\OpenWorker.AuthServer\appsettings.json" Link="Settings\AuthServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.GateServer\appsettings.json" Link="Settings\GateServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.DistrictServer\appsettings.json" Link="Settings\DistrictServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.MazeServer\appsettings.json" Link="Settings\MazeServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.RelayServer\appsettings.json" Link="Settings\RelayServer.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\OpenWorker.UpdateContent\appsettings.json" Link="Settings\UpdateContent.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

</Project>
