<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenWorker.Content.Tool.ViewModels"
        xmlns:views="using:OpenWorker.Content.Tool.Views"
        xmlns:rendering="using:OpenWorker.Content.Tool.Rendering"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="OpenWorker.Content.Tool.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100"
        Height="700"
        Title="OpenWorker Content Tool">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Viewport" Command="{Binding ShowViewportCommand}" />
                <MenuItem Header="Craftables" Command="{Binding ShowCraftablesCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="8,4"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid ColumnDefinitions="220,*">
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Text="Panels" />
                    <StackPanel Spacing="4">
                        <Button Content="Viewport"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ShowViewportCommand}" />
                        <Button Content="Craftables"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ShowCraftablesCommand}" />
                        <Button Content="Batch"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False" />
                        <Button Content="Navigation"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Panel Grid.Column="1">
                <Border Background="#FF1E1F24" IsVisible="{Binding IsViewportVisible}">
                    <rendering:DebugViewport />
                </Border>
                <Border IsVisible="{Binding IsCraftablesVisible}">
                    <views:CraftablesView DataContext="{Binding Craftables}" />
                </Border>
            </Panel>
        </Grid>
    </DockPanel>
</Window>
